{
  "name": "@wonder-wagon/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Wonder Wagon design tokens: the framework-neutral contract every Wonder Wagon product builds on. CSS custom properties, typed constants, DTCG JSON, and a measured contrast gate. No React.",
  "license": "MIT",
  "author": "Ricardo Lamadrid",
  "homepage": "https://github.com/rikilamadrid/wonder-wagon-ui/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/wonder-wagon-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/rikilamadrid/wonder-wagon-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "dtcg",
    "wcag",
    "wonder-wagon"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "default": "./dist/contrast.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./css": "./dist/tokens.css",
    "./css/unlayered": "./dist/tokens.unlayered.css",
    "./dtcg": "./dist/tokens.dtcg.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b --force && node dist/build.js",
    "check": "tsc -b --force && node dist/build.js --check",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
