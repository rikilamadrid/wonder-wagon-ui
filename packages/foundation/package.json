{
  "name": "wonder-wagon-ui",
  "version": "0.1.0",
  "description": "React-free Wonder Wagon foundations for product identity and interface distribution.",
  "license": "MIT",
  "author": "Ricardo Lamadrid",
  "homepage": "https://github.com/rikilamadrid/wonder-wagon-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/wonder-wagon-ui.git",
    "directory": "packages/foundation"
  },
  "bugs": {
    "url": "https://github.com/rikilamadrid/wonder-wagon-ui/issues"
  },
  "keywords": [
    "wonder-wagon",
    "design-system",
    "cli",
    "terminal",
    "codegen"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b --force",
    "check": "tsc -b --force",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
