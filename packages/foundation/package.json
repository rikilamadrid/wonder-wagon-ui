{
  "name": "wonder-wagon-ui",
  "version": "0.1.0",
  "description": "React-free Wonder Wagon foundations: CLI identity codegen and static design-token and theme assets.",
  "license": "MIT",
  "author": "Ricardo Lamadrid",
  "homepage": "https://github.com/rikilamadrid/wonder-wagon-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/wonder-wagon-ui.git",
    "directory": "packages/foundation"
  },
  "bugs": {
    "url": "https://github.com/rikilamadrid/wonder-wagon-ui/issues"
  },
  "keywords": [
    "wonder-wagon",
    "design-system",
    "cli",
    "terminal",
    "codegen",
    "design-tokens",
    "themes",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./tokens/tokens.css": "./dist/tokens/tokens.css",
    "./tokens/tokens.unlayered.css": "./dist/tokens/tokens.unlayered.css",
    "./tokens/tokens.dtcg.json": "./dist/tokens/tokens.dtcg.json",
    "./themes/wonder-wagon.css": "./dist/themes/wonder-wagon.css",
    "./themes/wonder-wagon.json": "./dist/themes/wonder-wagon.json",
    "./themes/pathfinder.css": "./dist/themes/pathfinder.css",
    "./themes/pathfinder.json": "./dist/themes/pathfinder.json",
    "./themes/forge.css": "./dist/themes/forge.css",
    "./themes/forge.json": "./dist/themes/forge.json",
    "./themes/lorekeeper.css": "./dist/themes/lorekeeper.css",
    "./themes/lorekeeper.json": "./dist/themes/lorekeeper.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b --force && node scripts/assets.mjs",
    "check": "tsc -b --force && node scripts/assets.mjs --check",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
