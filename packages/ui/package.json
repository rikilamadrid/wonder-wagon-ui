{
  "name": "@wonder-wagon/ui",
  "version": "0.1.0",
  "description": "React components for the Wonder Wagon family of tools. Reads @wonder-wagon/tokens' semantic layer and nothing else; ships plain CSS beside ESM.",
  "license": "MIT",
  "author": "Ricardo Lamadrid",
  "homepage": "https://github.com/rikilamadrid/wonder-wagon-ui/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/wonder-wagon-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/rikilamadrid/wonder-wagon-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "accessible",
    "wonder-wagon"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b --force && vite build && node scripts/build-css.mjs && node scripts/write-exports.mjs",
    "test": "vitest run",
    "test:gates": "vitest run --project gates",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly"
  },
  "peerDependencies": {
    "@wonder-wagon/tokens": "0.1.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.0.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@wonder-wagon/tokens": "0.1.0",
    "@wonder-wagon/themes": "0.1.0",
    "playwright": "1.63.0",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup-preserve-directives": "1.1.3",
    "size-limit": "14.0.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "Button (import { Button })",
      "path": "dist/button.js",
      "import": "{ Button }",
      "limit": "3 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "Phase A barrel",
      "path": "dist/index.js",
      "limit": "12 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "styles.css",
      "path": "dist/styles.css",
      "limit": "14 kB",
      "rolldown": false,
      "gzip": true
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button/index.d.ts",
      "default": "./dist/button.js"
    },
    "./field": {
      "types": "./dist/components/Field/index.d.ts",
      "default": "./dist/field.js"
    },
    "./input": {
      "types": "./dist/components/Input/index.d.ts",
      "default": "./dist/input.js"
    },
    "./stack": {
      "types": "./dist/components/Stack/index.d.ts",
      "default": "./dist/stack.js"
    },
    "./surface": {
      "types": "./dist/components/Surface/index.d.ts",
      "default": "./dist/surface.js"
    },
    "./switch": {
      "types": "./dist/components/Switch/index.d.ts",
      "default": "./dist/switch.js"
    },
    "./text": {
      "types": "./dist/components/Text/index.d.ts",
      "default": "./dist/text.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.unlayered.css": "./dist/styles.unlayered.css",
    "./button.css": "./dist/button.css",
    "./field.css": "./dist/field.css",
    "./input.css": "./dist/input.css",
    "./stack.css": "./dist/stack.css",
    "./surface.css": "./dist/surface.css",
    "./switch.css": "./dist/switch.css",
    "./text.css": "./dist/text.css",
    "./package.json": "./package.json"
  }
}
