---
import Badge from "../components/Badge.astro";
import ProductCard from "../components/ProductCard.astro";
import Terminal from "../components/Terminal.astro";
import Base from "../layouts/Base.astro";
import { total } from "../lib/contrast";
import {
  byId,
  COLUMNS,
  depthRow,
  drafts,
  ORDER,
  released,
  storybook,
  terminal,
  url,
} from "../lib/data";

const family = ORDER.map(byId);
const identityLines: Record<string, number> = {
  "wonder-wagon": 6,
  pathfinder: 5,
  lorekeeper: 6,
  forge: 5,
};
// At 40 columns each product takes its narrow form; Pathfinder keeps its frozen one-line fallback.
const narrowLines: Record<string, number> = {
  "wonder-wagon": 10,
  pathfinder: 1,
  lorekeeper: 11,
  forge: 9,
};
const rows = (["pathfinder", "lorekeeper", "forge", "lama"] as const).map((id) => ({
  id,
  name: id === "lama" ? "Lama" : byId(id).name,
  cells: depthRow(id),
}));
const attested = released.filter((p) => p.provenance.status === "attested").length;
---
<Base
  title="Wonder Wagon Catalog"
  description="One family. Different tools. How one small design system serves four released developer tools, standardizing only what the products have proven they share."
>
  <section class="showroom" aria-labelledby="hero">
    <div class="showroom__head">
      <span class="eyebrow">Wonder Wagon · Maker 047's bench</span>
      <h1 id="hero">One family. Different tools.</h1>
      <p class="thesis">Wonder Wagon standardizes only what real products have proven they share, and deliberately leaves the rest to each product.</p>
      <p class="lede">These are four released command-line tools, captured from their public npm packages. Same grammar, same fallbacks, same serial scheme. Different marks, colours and jobs.</p>
    </div>
    <div class="family family--wide">
      {family.map((p) => (
        <Terminal product={p.id} lines={identityLines[p.id]} label={`${p.name} identity, captured from ${p.package}@${p.version}`} />
      ))}
    </div>
    <div class="family family--narrow">
      {family.map((p) => (
        <Terminal product={p.id} tier="narrow" lines={narrowLines[p.id]} label={`${p.name} identity at 40 columns, captured from ${p.package}@${p.version}`} />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="split">
    <header>
      <span class="eyebrow">What the family shares, and what it doesn't</span>
      <h2 id="split">A small shared core. Everything else is the product's.</h2>
    </header>
    <div class="ledger">
      <div class="card shared">
        <h3>Shared: Wonder Wagon owns it</h3>
        <ul>
          <li>The terminal grammar<small>Mark beside a letterspaced name, version then serial, tagline below.</small></li>
          <li>Capability and fallback rules<small>Truecolor → 256 → 16 colours, NO_COLOR, WW_ASCII, TERM=dumb, narrow widths, silent when piped.</small></li>
          <li>Selected semantic foundations<small>Spacing, focus, reading measure, quiet shadows, where products agreed on the values.</small></li>
          <li>The theme contract<small>Six colour slots, an enamel, an object radius and a serial per product.</small></li>
        </ul>
      </div>
      <div class="card owned">
        <h3>Owned: each product keeps it</h3>
        <ul>
          <li>Marks and hero objects<small>The trail mark and atlascope, the four-point star, the furnace.</small></li>
          <li>Product metaphors<small>A field manual, a reading room, a smithy.</small></li>
          <li>Product grounds, where ruled<small>Forge's Iron night and Lorekeeper's parchment and indigo are theirs.</small></li>
          <li>Typography differences<small>Forge's web fonts; Lorekeeper's larger reading scale.</small></li>
          <li>Product-specific UI<small>Navigation, diagrams, docs chrome and everything else no second product has proven.</small></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="products">
    <header>
      <span class="eyebrow">Released tools</span>
      <h2 id="products">Four public packages</h2>
    </header>
    <div class="cards">
      {family.map((p) => <ProductCard product={p} />)}
      {drafts.map((d) => (
        <article class="pcard" data-draft>
          <span class="serial muted">No serial yet</span>
          <h3>{d.name}</h3>
          <Badge kind="draft">Draft · unreleased</Badge>
          <p class="role">{d.role}</p>
          <p class="role muted">Private repository. Nothing published, so nothing here to verify yet.</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="depth">
    <header>
      <span class="eyebrow">Integration depth</span>
      <h2 id="depth">Not every product uses every layer</h2>
      <p class="lede">Measured at each product's release commit. Pathfinder goes deepest; Forge takes only the terminal identity; the React components have no production consumer yet.</p>
    </header>
    <div class="table-card" tabindex="0" role="region" aria-label="Integration depth by product">
      <table class="depth">
        <thead><tr><th scope="col">Product</th>{COLUMNS.map((c) => <th scope="col">{c}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.id === "lama" ? <>Lama <span class="muted">(draft)</span></> : <a href={url(`products/${r.id}`)}>{r.name}</a>}</th>
              {r.cells.map((c) => <td><span class="state" data-state={c.state}>{c.text}</span></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="proof">
    <header>
      <span class="eyebrow">Released, not mocked</span>
      <h2 id="proof">Every claim here has a receipt</h2>
    </header>
    <div class="facts">
      <div class="fact"><b class="num">{released.length}</b><span>public npm packages</span></div>
      <div class="fact"><b class="num">{attested} of {released.length}</b><span>with trusted-publishing provenance; Forge follows its documented manual release</span></div>
      <div class="fact"><b class="num">{terminal.captures.length}</b><span>terminal captures from those packages</span></div>
      <div class="fact"><b class="num">{total}</b><span>colour pairings measured on every build, none failing</span></div>
    </div>
    <p class="row"><a href={url("evidence")}>See the evidence</a><span aria-hidden="true">·</span><a href={url("terminal")}>The terminal family</a><span aria-hidden="true">·</span><a href={storybook()}>Open the Storybook laboratory</a></p>
  </section>
</Base>
