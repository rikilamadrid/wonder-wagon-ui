---
import Badge from "../components/Badge.astro";
import Base from "../layouts/Base.astro";
import { storybook } from "../lib/data";

type Kind = "ready" | "proven" | "immature" | "product" | "experimental";
interface Pattern {
  name: string;
  kind: Kind;
  status?: string;
  what: string;
  where: string;
  next: string;
}
const shared: Pattern[] = [
  {
    name: "Terminal identity",
    kind: "ready",
    what: "The mark, name, version and serial, and tagline block, with its capability tiers and machine silence.",
    where:
      "All four released CLIs, generated by wonder-wagon-ui/cli and drift-checked in each repository.",
    next: "Standardized. Changes go through the generator and every product's frozen proofs.",
  },
  {
    name: "Environment contract",
    kind: "proven",
    status: "Shared behaviour, not a shared component",
    what: "data-ww-env on the root with day, night and auto; an explicit choice remembered; applied before first paint.",
    where:
      "Lorekeeper's fieldset toggle, Forge's single button, Pathfinder's Starlight select, this catalog's segmented control, and the experimental React EnvironmentSwitch. Five implementations in four frameworks.",
    next: "Document the attribute and pre-paint behaviour. Don't ship a component: no two products share a framework.",
  },
  {
    name: "Family plate",
    kind: "immature",
    what: "The serial as a small engraved plate, “LK-047 · a Wonder Wagon tool”, linking back to the family.",
    where:
      "Lorekeeper's footer, Pathfinder's site title, the Storybook tray, the doorway. Forge's website doesn't carry one.",
    next: "Agree the wording and the link target before it becomes a rule.",
  },
  {
    name: "Surface / card",
    kind: "immature",
    what: "A quiet card lifted off the page with a hairline and the quiet shadow.",
    where:
      "The values agree across --ww-surface, --pf-surface and --lk-surface in role; Forge uses its own. No shared code.",
    next: "Keep as tokens. A component only when a second product needs one.",
  },
  {
    name: "Provenance / evidence block",
    kind: "immature",
    what: "A claim shown beside the source that backs it: file, commit, command.",
    where:
      "Lorekeeper's Prov component, Forge's evidence section, Pathfinder's renderer citations, this catalog.",
    next: "A shared shape is visible. It needs one agreed data format before any shared markup.",
  },
  {
    name: "Code / terminal block",
    kind: "immature",
    what: "A command and its output in a dark well.",
    where:
      "Lorekeeper's Terminal component, Forge's command and code blocks, Pathfinder's recaptured transcripts, this catalog's capture renderer.",
    next: "The capture discipline (real runs, never hand-edited) is shared; the markup is not yet.",
  },
];
const notStandardized = [
  [
    "Navigation",
    "Starlight on Pathfinder, a contents index on Lorekeeper, none on Forge's single page.",
  ],
  ["Tables", "Only documentation tables; no product has a data table to compare."],
  ["Drawers and panels", "Only Pathfinder's architecture explorer has one."],
  [
    "Loading, empty and error states",
    "Only terminal progress output and an unreleased app. Nothing to compare yet.",
  ],
  ["Diagrams", "Pathfinder owns the render-artifact engine; the others hand-draw their diagrams."],
  ["Documentation chrome", "Three frameworks, three products' own designs."],
];
---
<Base title="Patterns" description="Which interface patterns the Wonder Wagon products have proven they share, which are still immature, and which stay product-owned.">
  <header class="page-head">
    <span class="eyebrow">Patterns · with maturity</span>
    <h1>Standardize what has been proven</h1>
    <p class="lede">A pattern becomes shared when more than one released product already does it the same way. Looking alike isn't enough. Each entry says where the evidence is and what would move it up.</p>
  </header>

  <div class="row" aria-label="Maturity key">
    <Badge kind="ready" /><Badge kind="proven" /><Badge kind="immature" /><Badge kind="product" /><Badge kind="experimental" />
  </div>

  <h2 class="visually-hidden">Shared and emerging patterns</h2>
  <section class="patterns" aria-label="Shared patterns">
    {shared.map((p) => (
      <article class="pattern">
        <Badge kind={p.kind}>{p.status}</Badge>
        <h3>{p.name}</h3>
        <p>{p.what}</p>
        <p class="where"><strong>Evidence:</strong> {p.where}</p>
        <p class="where"><strong>Next:</strong> {p.next}</p>
      </article>
    ))}
  </section>

  <section class="section" aria-labelledby="owned">
    <header>
      <span class="eyebrow">Deliberately not shared</span>
      <h2 id="owned">Product-owned</h2>
    </header>
    <div class="table-card" tabindex="0" role="region" aria-label="Product-owned patterns">
      <table>
        <thead><tr><th scope="col">Pattern</th><th scope="col">Status</th><th scope="col">Why it isn't a shared component</th></tr></thead>
        <tbody>{notStandardized.map(([name, why]) => <tr><td>{name}</td><td><Badge kind="product" /></td><td>{why}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="react">
    <header>
      <span class="eyebrow">The laboratory</span>
      <h2 id="react">Six React components <Badge kind="experimental">Experimental · no production consumers yet</Badge></h2>
    </header>
    <p>Text, Stack, Surface, Button, Field with Input, and Switch live in the Storybook laboratory with every state, keyboard walkthroughs and axe checks. None of the released products uses them: three of the four don't run React, and the one that does, Lama, is unreleased. They aren't published as a package, and they aren't the design system. They're where component ideas are tested until a real product needs one.</p>
    <p><a href={storybook()}>Open the Storybook laboratory</a></p>
  </section>
</Base>
