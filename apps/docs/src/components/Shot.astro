---
/** A committed screenshot of a live product site, with where and how it was taken. */
import type { ImageMetadata } from "astro";
import { sites } from "../lib/data";

interface Props {
  product: string;
  env: "day" | "night";
  device: "desktop" | "mobile";
  eager?: boolean;
}
const { product, env, device, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../evidence/sites/*.png", {
  eager: true,
});
const shot = sites.shots.find((s) => s.product === product && s.env === env && s.device === device);
if (!shot) throw new Error(`no screenshot ${product}/${env}/${device}`);
const image = images[`../evidence/sites/${shot.file}`]?.default;
if (!image) throw new Error(`missing ${shot.file}`);
const host = new URL(shot.url).host;
---
<figure class="shot" data-device={device}>
  <div class="shot__frame">
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={`${host} home page, ${env === "day" ? "light" : "dark"} scheme, ${device} viewport`}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  <figcaption><span>{host}</span><span class="muted"> · {env} · {shot.viewport.width}×{shot.viewport.height} · {sites.capturedOn}</span></figcaption>
</figure>
