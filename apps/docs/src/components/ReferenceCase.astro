---
// The system's own object, closed, as a sketch. One per viewport.
const { width = 520 } = Astro.props;
---
<svg viewBox="0 0 560 300" width={width} role="img" aria-label="The Reference Case, closed: a wide blackened-iron case with a Bench Green enamel lid, brass corner caps, two hinges, a glass well holding a brass gauge block, and a latch plate engraved WW-047." style="max-width:100%;height:auto;display:block">
  <defs>
    <linearGradient id="rc-brass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#C8863A"/><stop offset=".55" stop-color="#A96E2D"/><stop offset="1" stop-color="#6E4519"/></linearGradient>
    <linearGradient id="rc-enamel" x1=".15" y1="0" x2=".85" y2="1"><stop offset="0" stop-color="#3A7A2C"/><stop offset=".55" stop-color="#285A1C"/><stop offset="1" stop-color="#173A0F"/></linearGradient>
    <linearGradient id="rc-iron" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3A332C"/><stop offset="1" stop-color="#1E1A16"/></linearGradient>
    <linearGradient id="rc-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFFFFF" stop-opacity=".28"/><stop offset=".5" stop-color="#FFFFFF" stop-opacity="0"/></linearGradient>
    <filter id="rc-soft" x="-20%" y="-40%" width="140%" height="180%"><feGaussianBlur stdDeviation="9"/></filter>
    <filter id="rc-contact" x="-10%" y="-20%" width="120%" height="140%"><feGaussianBlur stdDeviation="2.5"/></filter>
  </defs>
  <ellipse cx="292" cy="248" rx="215" ry="26" fill="#000" opacity=".22" filter="url(#rc-soft)"/>
  <rect x="86" y="236" width="400" height="10" rx="5" fill="#000" opacity=".3" filter="url(#rc-contact)"/>
  <rect x="80" y="86" width="400" height="152" rx="10" fill="url(#rc-iron)"/>
  <rect x="82" y="88" width="396" height="2" rx="1" fill="#FFF7E6" opacity=".18"/>
  <rect x="88" y="194" width="384" height="38" rx="6" fill="#2A241F"/>
  <rect x="150" y="80" width="46" height="12" rx="3" fill="url(#rc-brass)"/><rect x="364" y="80" width="46" height="12" rx="3" fill="url(#rc-brass)"/>
  <rect x="88" y="94" width="384" height="96" rx="7" fill="#000" opacity=".45"/>
  <rect x="90" y="96" width="380" height="92" rx="6" fill="url(#rc-enamel)"/>
  <rect x="92" y="98" width="376" height="1.5" rx="1" fill="#FFF7E6" opacity=".3"/>
  <path d="M448 96 L470 96 L470 116 Z" fill="#2B2622"/><path d="M452 97 L468 97 L468 111 Z" fill="#E9CFA0" opacity=".55"/>
  <path d="M80 110 V96 A10 10 0 0 1 90 86 H104 V96 H92 V110 Z" fill="url(#rc-brass)"/>
  <path d="M480 110 V96 A10 10 0 0 0 470 86 H456 V96 H468 V110 Z" fill="url(#rc-brass)"/>
  <path d="M80 214 V228 A10 10 0 0 0 90 238 H104 V228 H92 V214 Z" fill="url(#rc-brass)"/>
  <path d="M480 214 V228 A10 10 0 0 1 470 238 H456 V228 H468 V214 Z" fill="#7A5A2A"/>
  <rect x="246" y="116" width="68" height="50" rx="6" fill="#0B1A0A"/><rect x="248" y="118" width="64" height="46" rx="5" fill="#101C10"/>
  <rect x="262" y="128" width="36" height="24" rx="2" fill="url(#rc-brass)"/>
  <text x="280" y="144" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="8.5" font-weight="800" fill="#2A160D" letter-spacing=".6">1.000</text>
  <rect x="246" y="116" width="68" height="50" rx="6" fill="url(#rc-glass)"/>
  <rect x="252" y="200" width="56" height="26" rx="3" fill="url(#rc-brass)"/>
  <text x="280" y="216" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="8" font-weight="800" fill="#2A160D" letter-spacing="1.2">WW-047</text>
  <rect x="270" y="188" width="20" height="10" rx="2" fill="#E2B26A"/>
</svg>
