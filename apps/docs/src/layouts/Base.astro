---
import "@wonder-wagon/tokens/css";
import "@wonder-wagon/themes/wonder-wagon.css";
import "../styles/docs.css";
import "../styles/catalog.css";
import { storybook, system, url } from "../lib/data";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const here = Astro.url.pathname;
const nav = [
  ["", "Overview"],
  ["themes", "Themes"],
  ["products", "Products"],
  ["terminal", "Terminal family"],
  ["patterns", "Patterns"],
  ["accessibility", "Accessibility"],
  ["evidence", "Evidence"],
] as const;
const current = (path: string) => (path === "" ? here === url() : here.startsWith(url(path)));
const pageTitle = title === "Wonder Wagon Catalog" ? title : `${title} · Wonder Wagon Catalog`;
const canonical = new URL(here, Astro.site);
---
<!doctype html>
<html lang="en" data-ww-env="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#FBF3DE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17191C" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <script is:inline define:vars={{ root: url(), lab: storybook() }}>
      // Links into the old Storybook, which answered at this root, keep working: its query
      // and hash move to /storybook/ unchanged.
      if ((location.pathname === root || location.pathname === root + "index.html") && /(^|[?&])(path|id|viewMode)=/.test(location.search)) {
        location.replace(lab + location.search + location.hash);
      }
      // The environment contract: the attribute on <html> is the truth; an explicit choice
      // from the toggle is remembered, and "auto" follows the system.
      try {
        var e = localStorage.getItem("ww-catalog-env");
        if (e === "day" || e === "night") document.documentElement.setAttribute("data-ww-env", e);
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="frame">
      <header class="wrap bar">
        <a class="lockup" href={url()}>
          <span class="well" aria-hidden="true">
            <svg viewBox="0 0 32 20" width="26" height="16"><rect x="1" y="4" width="30" height="14" rx="2" fill="#2B2622"/><rect x="2.5" y="5.5" width="27" height="8" rx="1.5" fill="#285A1C"/><rect x="2.5" y="5.5" width="27" height="1" fill="#FFF7E6" opacity=".35"/><rect x="1" y="4" width="4" height="4" fill="#C8863A"/><rect x="27" y="4" width="4" height="4" fill="#C8863A"/><rect x="1" y="14" width="4" height="4" fill="#C8863A"/><rect x="27" y="14" width="4" height="4" fill="#C8863A"/><rect x="13" y="13" width="6" height="3" rx=".5" fill="#A96E2D"/></svg>
          </span>
          <span>
            <span class="name">Wonder Wagon</span><br />
            <span class="sub plate"><span>Catalog</span><span class="dot" aria-hidden="true"></span><span>{system.serial}</span></span>
          </span>
        </a>
        <div class="env" role="group" aria-label="Colour environment">
          <button type="button" data-env="day" aria-pressed="false">Day</button>
          <button type="button" data-env="night" aria-pressed="false">Night</button>
          <button type="button" data-env="auto" aria-pressed="true">Auto</button>
        </div>
        <nav class="primary" aria-label="Primary">
          {nav.map(([path, label]) => (
            <a href={url(path)} aria-current={current(path) ? "page" : undefined}>{label}</a>
          ))}
          <a href={storybook()} class="lab">Storybook</a>
        </nav>
      </header>
      <main id="main" class="wrap">
        <slot />
      </main>
      <footer class="wrap foot">
        <span>Wonder Wagon · Maker 047's bench · MIT · <a href="https://github.com/rikilamadrid/wonder-wagon-ui">GitHub</a></span>
        <span>Every version, date and number on these pages is read from npm and GitHub; see <a href={url("evidence")}>Evidence</a>.</span>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var buttons = document.querySelectorAll(".env button");
        function show(env) {
          buttons.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.env === env)); });
        }
        show(root.getAttribute("data-ww-env") || "auto");
        buttons.forEach(function (b) {
          b.addEventListener("click", function () {
            var env = b.dataset.env;
            root.setAttribute("data-ww-env", env);
            try {
              if (env === "auto") localStorage.removeItem("ww-catalog-env");
              else localStorage.setItem("ww-catalog-env", env);
            } catch (_) {}
            show(env);
          });
        });
      })();
    </script>
  </body>
</html>
